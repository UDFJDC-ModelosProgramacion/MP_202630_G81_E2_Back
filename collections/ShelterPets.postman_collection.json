            "{{baseUrl}}"
          ],
          "path": [
            "shelters",
            "{{shelter_id}}",
            "pets",
            "{{pet_id_1}}"
          ]
        },
        "description": "Asocia una mascota existente ({{pet_id_1}}) a un refugio. No lleva body; responde con una mascota asociada."
