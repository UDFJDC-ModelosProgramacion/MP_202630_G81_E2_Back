              "});",
              "",
              "pm.test(\"Response is a non-empty list\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\");",
              "    pm.expect(data.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"List contains the added pet\", function () {",
              "    var data = pm.response.json();",
              "    var ids = data.map(function (e) { return e.id; });",
