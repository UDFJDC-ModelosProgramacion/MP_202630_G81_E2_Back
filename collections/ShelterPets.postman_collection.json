    {
      "name": "Agregar una mascota a un refugio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Returns the associated pet\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.id).to.eql(parseInt(pm.collectionVariables.get(\"pet_id_1\")));",
              "    pm.expect(data.name).to.exist;",
              "    pm.expect(data.species).to.exist;",
              "    pm.expect(data.breed).to.exist;",
              "    pm.expect(data.age).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
