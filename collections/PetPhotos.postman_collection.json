      "name": "Asociar fotos a una mascota",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Pet now has exactly the 2 sent photos\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.length).to.eql(2);",
              "});",
              "",
              "pm.test(\"Response contains the 2 sent photo ids\", function () {",
              "    var data = pm.response.json();",
              "    var ids = data.map(function (e) { return e.id; });",
              "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get(\"photo_id_1\")));",
              "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get(\"photo_id_2\")));",
              "});"
            ]
