    {
      "name": "Agregar una foto a una mascota",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Returns the associated photo\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.id).to.eql(parseInt(pm.collectionVariables.get(\"photo_id_1\")));",
              "    pm.expect(data.url).to.exist;",
              "    pm.expect(data.type).to.exist;",
              "});"
            ]
          }
        }
      ],
