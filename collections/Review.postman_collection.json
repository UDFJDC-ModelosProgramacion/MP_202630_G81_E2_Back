							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pets/999999/reviews",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pets",
								"999999",
								"reviews"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"comment\": \"Excelente proceso de adopcion, el refugio acompano todo el tiempo.\",\n    \"date\": \"2026-05-20\",\n    \"time\": \"2026-05-20T19:30:00.000Z\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 412\", function () {",
									"   pm.response.to.have.status(412);",
									"});",
									"",
									"pm.test(\"Get expected error message\", function () {",
									"   var data = pm.response.json();",
									"",
									"   pm.expect(data.apierror.message).to.eql(\"Rating cannot be null\");",
									"});"
								],
								"type": "text/javascript"
							}
