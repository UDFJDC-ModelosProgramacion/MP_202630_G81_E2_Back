            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Returns the associated medical event\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.id).to.eql(parseInt(pm.collectionVariables.get(\"medical_event_id_1\")));",
              "    pm.expect(data.date).to.exist;",
              "    pm.expect(data.type).to.exist;",
              "    pm.expect(data.description).to.exist;",
              "});"
            ]
          }
        }
