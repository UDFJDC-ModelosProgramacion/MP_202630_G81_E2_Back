              "    pm.expect(data.length).to.eql(3);",
              "});",
              "",
              "pm.test(\"Response contains the 3 sent event ids\", function () {",
              "    var data = pm.response.json();",
              "    var ids = data.map(function (e) { return e.id; });",
              "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get(\"medical_event_id_arrival\")));",
              "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get(\"medical_event_id_1\")));",
              "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get(\"medical_event_id_2\")));",
              "});"
            ]
          }
        }
