								"{{user_id_1}}",
								"notifications"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"Su solicitud de adopcion fue aprobada\",\n    \"date\": \"2026-05-18\",\n    \"time\": \"2026-05-18T14:15:00.000Z\",\n    \"content\": \"Felicitaciones, su solicitud para Luna fue aprobada. Comuniquese con el refugio.\",\n    \"channel\": \"EMAIL\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var data = pm.response.json()",
									"",
									"pm.globals.set(\"notification_id\", data.id);",
									"",
									"pm.test(\"Status code is 201\", function () {",
									"   pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Notification is created unsent by default\", function () {",
									"   var data = pm.response.json();",
									"",
									"   pm.expect(data.sent).to.eql(false);",
									"   pm.expect(data.channel).to.eql(\"EMAIL\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
