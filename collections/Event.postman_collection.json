	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Fechas relativas a hoy (12:00 UTC para evitar cambios de dia por zona horaria)",
					"function iso(days) {",
					"   const n = new Date();",
					"   return new Date(Date.UTC(n.getUTCFullYear(), n.getUTCMonth(), n.getUTCDate() + days, 12, 0, 0)).toISOString();",
					"}",
					"pm.collectionVariables.set(\"d_past_400\", iso(-400));",
					"pm.collectionVariables.set(\"d_past_100\", iso(-100));",
					"pm.collectionVariables.set(\"d_past_30\", iso(-30));",
					"pm.collectionVariables.set(\"d_past_1\", iso(-1));",
					"pm.collectionVariables.set(\"d_future_1\", iso(1));",
					"pm.collectionVariables.set(\"d_future_30\", iso(30));",
					"pm.collectionVariables.set(\"d_future_45\", iso(45));",
					"pm.collectionVariables.set(\"d_future_60\", iso(60));",
					"pm.collectionVariables.set(\"d_future_365\", iso(365));",
					"if (!pm.collectionVariables.get(\"run_id\")) {",
					"   pm.collectionVariables.set(\"run_id\", Date.now().toString(36));",
					"}",
					"pm.collectionVariables.set(\"day_future_30\", iso(30).substring(0, 10));",
					"pm.collectionVariables.set(\"day_future_60\", iso(60).substring(0, 10));"
				]
			}
		}
