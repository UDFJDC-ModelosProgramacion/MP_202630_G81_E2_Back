							"raw": "{{baseUrl}}/vaccinationRecords",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"vaccinationRecords"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 412\", function () {",
									"   pm.response.to.have.status(412);",
									"});",
									"",
									"pm.test(\"Get expected error message\", function () {",
									"   var data = pm.response.json();",
									"",
									"   pm.expect(data.apierror.message).to.eql(\"Vaccination record must be associated with an existing pet\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
