					"mode": "raw",
					"raw": "{\n    \"message\": \"Hello, I am interested in adopting a pet.\",\n    \"sendUser\": {\n        \"id\": {{sender_user_id}}\n    },\n    \"receivesUser\": {\n        \"id\": {{receiver_user_id}}\n    }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/messages?currentUserId={{sender_user_id}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"messages"
					],
					"query": [
						{
							"key": "currentUserId",
							"value": "{{sender_user_id}}"
						}
					]
				}
			},
			"response": []
		},
