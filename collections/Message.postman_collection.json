	"item": [
		{
			"name": "Preparacion: Crear Usuario Emisor",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.collectionVariables.set(\"sender_email\", \"emisor.\" + Date.now() + \"@example.com\");"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"var data = pm.response.json();",
							"pm.collectionVariables.set(\"sender_user_id\", data.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"firstName\": \"Emisor\",\n    \"lastName\": \"Mensaje\",\n    \"email\": \"{{sender_email}}\",\n    \"password\": \"Password123!\",\n    \"phone\": \"3001112233\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users"
					]
				}
			},
			"response": []
		},
