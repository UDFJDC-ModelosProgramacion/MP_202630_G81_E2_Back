				"body": {
					"mode": "raw",
					"raw": "{\n    \"firstName\": \"Receptor\",\n    \"lastName\": \"Mensaje\",\n    \"email\": \"{{receiver_email}}\",\n    \"password\": \"Password123!\",\n    \"phone\": \"3004445566\"\n}"
