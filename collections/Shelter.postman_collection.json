    {
      "name": "Crear un refugio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var data = pm.response.json();",
              "if (data.id) {",
              "    pm.collectionVariables.set(\"shelter_id\", data.id);",
              "    pm.environment.set(\"shelter_id\", data.id);",
              "}",
              "",
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Shelter created with the sent data\", function () {",
              "    pm.expect(data.id).to.be.a(\"number\");",
              "    pm.expect(data.name).to.eql(\"Refugio Huellitas\");",
              "    pm.expect(data.city).to.eql(\"Bogota\");",
              "    pm.expect(data.nit).to.eql(\"900123456-7\");",
              "    pm.expect(data.location).to.eql(\"Chapinero\");",
              "});"
            ]
          }
        }
      ],
