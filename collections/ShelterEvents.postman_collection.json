              "});",
              "",
              "pm.test(\"Shelter now has exactly the 2 sent events\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.length).to.eql(2);",
              "});",
              "",
              "pm.test(\"Response contains the 2 sent event ids\", function () {",
              "    var data = pm.response.json();",
              "    var ids = data.map(function (e) { return e.id; });",
              "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get(\"event_id_1\")));",
              "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get(\"event_id_2\")));",
              "});"
