              "raw": "{\n    \"name\": \"Jornada de adopcion\",\n    \"type\": \"Adopcion\",\n    \"date\": \"2027-03-20T00:00:00-05:00\",\n    \"time\": \"10:00\",\n    \"description\": \"Jornada abierta para conocer y adoptar mascotas del refugio.\",\n    \"location\": \"Parque El Virrey\"\n}",
