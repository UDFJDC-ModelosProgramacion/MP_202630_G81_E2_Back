    {
      "name": "Agregar un evento a un refugio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Returns the associated event\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.id).to.eql(parseInt(pm.collectionVariables.get(\"event_id_1\")));",
              "    pm.expect(data.name).to.exist;",
              "    pm.expect(data.date).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "shelters",
            "{{shelter_id}}",
            "events",
            "{{event_id_1}}"
          ],
          "raw": "{{baseUrl}}/shelters/{{shelter_id}}/events/{{event_id_1}}"
        },
        "description": "Asocia un evento existente ({{event_id_1}}) a un refugio. No lleva body; responde con un evento asociado."
      },
      "response": []
