              "raw": "{\n    \"name\": \"Campana de vacunacion\",\n    \"date\": \"2027-04-10T00:00:00-05:00\",\n    \"time\": \"09:00\",\n    \"description\": \"Vacunacion gratuita para mascotas de la comunidad.\",\n    \"location\": \"Salon comunal Chapinero\"\n}",
              "options": {
