    {
      "name": "Obtener los eventos de un refugio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a non-empty list\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\");",
              "    pm.expect(data.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"List contains the added event\", function () {",
              "    var data = pm.response.json();",
              "    var ids = data.map(function (e) { return e.id; });",
              "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get(\"event_id_1\")));",
              "});"
            ]
          }
        }
