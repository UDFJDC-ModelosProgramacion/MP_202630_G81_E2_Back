  "item": [
    {
      "name": "Preparacion",
      "description": "Crea los datos que necesita esta coleccion para correr sola, sin depender de otras colecciones ni de datos sembrados. Ejecutar siempre primero (el Runner ya la corre de primera).",
      "item": [
        {
          "name": "Crear usuario responsable",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var uniq = Date.now().toString() + Math.floor(Math.random() * 1000);",
                  "pm.variables.set(\"uniq\", uniq);",
                  "pm.variables.set(\"nit\", \"9\" + uniq.slice(-8) + \"-\" + Math.floor(Math.random() * 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Preparacion: Crear usuario responsable\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.id).to.be.a(\"number\");",
                  "    pm.collectionVariables.set(\"user_id_1\", data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/postman/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "postman",
                "users"
              ]
            },
            "description": "Crea un usuario responsable. Ajustar el body a los atributos de UserEntity si el API pide otros.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Usuario Prueba {{uniq}}\",\n    \"email\": \"prep{{uniq}}@example.com\",\n    \"phone\": \"3001234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Crear refugio",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var uniq = Date.now().toString() + Math.floor(Math.random() * 1000);",
                  "pm.variables.set(\"uniq\", uniq);",
                  "pm.variables.set(\"nit\", \"9\" + uniq.slice(-8) + \"-\" + Math.floor(Math.random() * 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Preparacion: Crear refugio\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.id).to.be.a(\"number\");",
                  "    pm.collectionVariables.set(\"shelter_id\", data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shelters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shelters"
              ]
            },
            "description": "Crea un refugio con nit unico asociado al usuario {{user_id_1}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Refugio Prep {{uniq}}\",\n    \"city\": \"Bogota\",\n    \"nit\": \"{{nit}}\",\n    \"location\": \"Chapinero\",\n    \"users\": [\n        {\n            \"id\": {{user_id_1}}\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
